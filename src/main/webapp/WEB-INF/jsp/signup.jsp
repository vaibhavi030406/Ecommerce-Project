<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Create account | Little Market</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="fragments/header.jspf" %>
<main class="auth"><p class="eyebrow">JOIN THE MARKET</p><h1>Create account</h1><p class="muted">A few details and you're ready to shop.</p><c:if test="${not empty error}"><div class="notice error"><c:out value="${error}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/signup"><label>Username<input name="username" required minlength="3" maxlength="40" placeholder="Choose a username" autocomplete="username"></label><label>Password<input type="password" name="password" required minlength="4" placeholder="At least 4 characters" autocomplete="new-password"></label><button class="button full" type="submit">Create account</button></form><p class="auth-foot">Already registered? <a href="${pageContext.request.contextPath}/login">Sign in</a></p><p class="muted small-note">Demo note: accounts are stored in memory and reset when the app restarts.</p></main></body></html>
