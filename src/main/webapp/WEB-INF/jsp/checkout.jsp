<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Checkout | Little Market</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="fragments/header.jspf" %><main class="auth checkout"><p class="eyebrow">ONE LAST LOOK</p><h1>Checkout</h1><p class="muted">Review your items before placing the demo order.</p><div class="checkout-items"><c:forEach var="item" items="${items}"><p><span><c:out value="${item.product.name}"/> × ${item.quantity}</span><strong>₹<c:out value="${item.subtotal}"/></strong></p></c:forEach></div><div class="total"><span>Total</span><strong>₹<c:out value="${total}"/></strong></div><div class="notice">This is a demonstration checkout. No payment details are collected and no real payment is processed.</div><form method="post" action="${pageContext.request.contextPath}/checkout"><button class="button full" type="submit">Place demo order</button></form><p><a class="continue-link" href="${pageContext.request.contextPath}/cart">← Return to cart</a></p></main></body></html>
