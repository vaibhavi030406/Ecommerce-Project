<%@ page contentType="text/html;charset=UTF-8" %>
<header class="topbar"><div class="nav-inner"><a class="brand" href="${pageContext.request.contextPath}/products"><span class="brand-mark">l.</span> little market</a>
<nav aria-label="Main navigation"><a href="${pageContext.request.contextPath}/products">Shop</a>
<% if (session.getAttribute("user") != null) { %>
<a href="${pageContext.request.contextPath}/cart">Cart <span class="cart-count">${empty sessionScope.cart ? 0 : sessionScope.cart.size()}</span></a><a href="${pageContext.request.contextPath}/logout">Logout</a>
<% } else { %><a href="${pageContext.request.contextPath}/login">Login</a><a class="nav-cta" href="${pageContext.request.contextPath}/signup">Create account</a><% } %>
</nav></div></header>
