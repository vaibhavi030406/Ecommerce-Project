<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><c:out value="${product.name}"/> | Little Market</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="fragments/header.jspf" %><main class="wrap detail"><img src="${product.image}" alt="${product.name}" loading="eager" decoding="async"><div><p class="eyebrow"><c:out value="${product.category}"/></p><h1><c:out value="${product.name}"/></h1><p class="detail-description"><c:out value="${product.description}"/></p><h2 class="price">₹<c:out value="${product.price}"/></h2><p class="muted">Available for demo purchase</p><form method="post" action="${pageContext.request.contextPath}/cart/add" class="detail-form"><input type="hidden" name="productId" value="${product.id}"><label>Quantity <input type="number" name="quantity" value="1" min="1" max="99"></label><button class="button" type="submit">Add to cart</button></form><p><a class="continue-link" href="${pageContext.request.contextPath}/products">← Back to products</a></p></div></main></body></html>
