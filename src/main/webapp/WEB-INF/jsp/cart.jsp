<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Your cart | Little Market</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="fragments/header.jspf" %>
<main class="wrap page"><p class="eyebrow">YOUR SELECTION</p><h1>Shopping cart</h1><c:if test="${not empty success}"><div class="notice"><c:out value="${success}"/></div></c:if><c:choose><c:when test="${empty items}"><div class="empty"><h3>Your cart is empty</h3><p>Explore the collection and add something you like.</p><a class="button" href="${pageContext.request.contextPath}/products">Continue shopping</a></div></c:when><c:otherwise><div class="cart-list"><c:forEach var="item" items="${items}"><div class="cart-row"><img src="${item.product.image}" alt="${item.product.name}" loading="lazy" decoding="async"><div class="cart-name"><h3><c:out value="${item.product.name}"/></h3><small>₹<c:out value="${item.product.price}"/> each</small></div><form class="quantity-form" action="${pageContext.request.contextPath}/cart/update" method="post"><input type="hidden" name="productId" value="${item.product.id}"><label class="sr-only" for="qty-${item.product.id}">Quantity</label><input id="qty-${item.product.id}" type="number" name="quantity" min="0" max="99" value="${item.quantity}"><button class="text-button" type="submit">Update</button></form><strong class="line-total">₹<c:out value="${item.subtotal}"/></strong><form action="${pageContext.request.contextPath}/cart/remove" method="post"><input type="hidden" name="productId" value="${item.product.id}"><button class="text-button danger" type="submit">Remove</button></form></div></c:forEach></div><div class="cart-summary"><p><span>Subtotal</span><strong>₹<c:out value="${total}"/></strong></p><small>Shipping and taxes are not included in this demo.</small><a class="button full" href="${pageContext.request.contextPath}/checkout">Continue to checkout</a><a class="continue-link" href="${pageContext.request.contextPath}/products">← Continue shopping</a></div></c:otherwise></c:choose></main></body></html>
